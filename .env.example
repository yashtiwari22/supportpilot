# Database Configuration (Docker Compose or External Postgres with pgvector)
DB_HOST=localhost
DB_PORT=5434
DB_NAME=supportpilot
DB_USER=supportpilot
DB_PASSWORD=supportpilot_secret

# LLM Provider Configuration
# Options: mock, gemini
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# JWT Configuration for Console Staff
JWT_SECRET=demo_insecure_jwt_secret_key_minimum_32_bytes_long!
JWT_EXPIRATION_HOURS=24

# Queue Configuration
# Options: postgres, kafka
QUEUE_TYPE=postgres
QUEUE_CONCURRENCY=4
QUEUE_POLL_INTERVAL_MS=500
QUEUE_VISIBILITY_TIMEOUT_SECONDS=60
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TICKETS=supportpilot.tickets
KAFKA_GROUP_ID=supportpilot-workers

# Rate Limiter (Token Bucket per tenant)
RATE_LIMIT_PER_MINUTE=60

# Server Configuration
PORT=8080
LOG_LEVEL=INFO
